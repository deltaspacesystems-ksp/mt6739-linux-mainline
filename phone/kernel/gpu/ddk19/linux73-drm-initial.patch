+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef MFW_MFG_POWER_SEQUENCE_H
+#define MFW_MFG_POWER_SEQUENCE_H
+/* MT6739 stock-matched sequencing. Caller provides a prepared26MHz clock,
+ * verified read-only VCORE voltage, exclusive operation lock and bounded polls.
+ * No firmware, voltage, PLL, HWAPM or GPU MMIO here. On failure caller MUST
+ * retain the clock if either domain may still be powered; never blind rollback.
+ */
+#ifdef __KERNEL__
+#include <linux/types.h>
+#else
+#include <stdint.h>
+typedef uint32_t u32;
+#endif
+enum mfw_mfg_block { MFW_MFG_SPM, MFW_MFG_INFRA_AO, MFW_MFG_INFRA };
+struct mfw_mfg_io {
+ void *ctx;
+ u32 (*read)(void *,enum mfw_mfg_block,u32);
+ void (*write)(void *,enum mfw_mfg_block,u32,u32);
+ int (*poll)(void *,enum mfw_mfg_block,u32,u32,u32);
+ int (*idle)(void *);
+ unsigned stage;
+};
+static inline void mfw_mfg_update(struct mfw_mfg_io *io,enum mfw_mfg_block b,u32 off,u32 mask,u32 value){
+ io->write(io->ctx,b,off,(io->read(io->ctx,b,off)&~mask)|(value&mask));
+}
+static inline int mfw_mfg_status(struct mfw_mfg_io *io,u32 mask,u32 value){
+ int ret=io->poll(io->ctx,MFW_MFG_SPM,0x180,mask,value);
+ return ret?ret:io->poll(io->ctx,MFW_MFG_SPM,0x184,mask,value);
+}
+static inline int mfw_mfg_domain_on(struct mfw_mfg_io *io,u32 off,u32 mask){
+ int ret;
+ mfw_mfg_update(io,MFW_MFG_SPM,off,4,4);
+ mfw_mfg_update(io,MFW_MFG_SPM,off,8,8);
+ ret=mfw_mfg_status(io,mask,mask);if(ret)return ret;
+ mfw_mfg_update(io,MFW_MFG_SPM,off,16,0);
+ mfw_mfg_update(io,MFW_MFG_SPM,off,2,0);
+ mfw_mfg_update(io,MFW_MFG_SPM,off,1,1);
+ mfw_mfg_update(io,MFW_MFG_SPM,off,32,0);
+ return io->poll(io->ctx,MFW_MFG_SPM,off,64,0);
+}
+static inline int mfw_mfg_domain_off(struct mfw_mfg_io *io,u32 off,u32 mask){
+ int ret;
+ mfw_mfg_update(io,MFW_MFG_SPM,off,32,32);
+ ret=io->poll(io->ctx,MFW_MFG_SPM,off,64,64);if(ret)return ret;
+ mfw_mfg_update(io,MFW_MFG_SPM,off,2,2);
+ mfw_mfg_update(io,MFW_MFG_SPM,off,16,16);
+ mfw_mfg_update(io,MFW_MFG_SPM,off,1,0);
+ mfw_mfg_update(io,MFW_MFG_SPM,off,4,0);
+ mfw_mfg_update(io,MFW_MFG_SPM,off,8,0);
+ return mfw_mfg_status(io,mask,0);
+}
+static inline int mfw_mfg_power_up(struct mfw_mfg_io *io){
+ int ret;io->stage=1;
+ ret=mfw_mfg_domain_on(io,0x338,1U<<4);if(ret)return ret;
+ io->stage=2;io->write(io->ctx,MFW_MFG_INFRA_AO,0x2a4,0x600000);
+ mfw_mfg_update(io,MFW_MFG_INFRA_AO,0x200,2,0);
+ mfw_mfg_update(io,MFW_MFG_INFRA_AO,0x200,128,128);
+ ret=io->idle(io->ctx);if(ret)return ret;
+ io->stage=3;ret=mfw_mfg_domain_on(io,0x33c,1U<<31);if(ret)return ret;
+ io->stage=4;return 0;
+}
+static inline int mfw_mfg_power_down(struct mfw_mfg_io *io){
+ int ret;io->stage=5;
+ ret=mfw_mfg_domain_off(io,0x33c,1U<<31);if(ret)return ret;
+ io->stage=6;mfw_mfg_update(io,MFW_MFG_INFRA_AO,0x200,128,0);
+ ret=io->idle(io->ctx);if(ret)return ret;
+ mfw_mfg_update(io,MFW_MFG_INFRA_AO,0x200,2,2);
+ io->write(io->ctx,MFW_MFG_INFRA_AO,0x2a0,0x600000);
+ ret=io->poll(io->ctx,MFW_MFG_INFRA_AO,0x228,0x600000,0x600000);if(ret)return ret;
+ io->stage=7;ret=mfw_mfg_domain_off(io,0x338,1U<<4);if(ret)return ret;
+ io->stage=8;return 0;
+}
+#endif
--- /dev/null
+++ b/services/system/rgx_mtk/mfw-ddk-power.c
@@ -0,0 +1,166 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Native MT6739 power integration. Reuses v59's bounded, HW-verified sequence.
+ * Fixed 26 MHz, read-only VCORE. No vendor DVFS/HWAPM/voltage/PLL writes.
+ * Only explicit future DDK binding can invoke this; not installed on the phone.
+ */
+#include <linux/clk.h>
+#include <linux/err.h>
+#include <linux/io.h>
+#include <linux/iopoll.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/of_platform.h>
+#include <linux/platform_device.h>
+#include <linux/regulator/consumer.h>
+#include <linux/slab.h>
+#include "mfw-ddk-power.h"
+#include "mfw-mfg-power-sequence.h"
+
+struct mfw_ddk_power {
+	struct device *dev;
+	struct platform_device *pmic;
+	struct clk *clock;
+	void __iomem *blocks[3];
+	struct mutex lock;
+	bool on, clock_held, faulted;
+};
+static u32 mfw_read(void *ctx, enum mfw_mfg_block block, u32 offset)
+{ return readl(((struct mfw_ddk_power *)ctx)->blocks[block] + offset); }
+static void mfw_write(void *ctx, enum mfw_mfg_block block, u32 offset, u32 value)
+{ writel(value, ((struct mfw_ddk_power *)ctx)->blocks[block] + offset); }
+static int mfw_poll(void *ctx, enum mfw_mfg_block block, u32 offset, u32 mask, u32 wanted)
+{
+	u32 value;
+	return readl_poll_timeout(((struct mfw_ddk_power *)ctx)->blocks[block] + offset,
+		value, (value & mask) == wanted, 10, 100000);
+}
+static int mfw_idle(void *ctx)
+{
+	u32 value;
+	return readl_poll_timeout(((struct mfw_ddk_power *)ctx)->blocks[MFW_MFG_INFRA],
+		value, (value & BIT(24)) || !(value & GENMASK(15, 14)), 10, 100000);
+}
+static bool mfw_off(struct mfw_ddk_power *p)
+{ return !((mfw_read(p, 0, 0x180) | mfw_read(p, 0, 0x184)) & 0x80000010); }
+static int mfw_vcore_check(struct mfw_ddk_power *p)
+{
+	struct regulator *vcore;
+	int ret;
+	device_lock(&p->pmic->dev);
+	if (!p->pmic->dev.driver) { ret = -ENODEV; goto unlock; }
+	vcore = regulator_get(p->dev, "vcore");
+	if (IS_ERR(vcore)) { ret = PTR_ERR(vcore); goto unlock; }
+	ret = regulator_get_voltage(vcore);
+	if (ret >= 0 && (ret < 1050000 || ret > 1312500)) ret = -ERANGE;
+	if (ret > 0) {
+		ret = regulator_is_enabled(vcore);
+		if (!ret) ret = -EHOSTDOWN;
+		else if (ret > 0) ret = 0;
+	}
+	regulator_put(vcore);
+unlock:
+	device_unlock(&p->pmic->dev);
+	return ret;
+}
+static int mfw_set_power(struct mfw_ddk_power *p, bool on)
+{
+	struct mfw_mfg_io io = { p, mfw_read, mfw_write, mfw_poll, mfw_idle, 0 };
+	int ret = 0;
+	mutex_lock(&p->lock);
+	if (p->faulted) { ret = -EIO; goto out; }
+	if (p->on == on) goto out;
+	if (on) {
+		ret = mfw_vcore_check(p);
+		if (ret) goto out;
+		if (!mfw_off(p) || (mfw_read(p, 0, 0x338) & 127) != 0x72 ||
+		    (mfw_read(p, 0, 0x33c) & 127) != 0x72) { ret = -EBUSY; goto out; }
+		ret = clk_set_rate(p->clock, 26000000);
+		if (ret) goto out;
+		ret = clk_prepare_enable(p->clock);
+		if (ret) goto out;
+		p->clock_held = true;
+		if (clk_get_rate(p->clock) != 26000000) {
+			clk_disable_unprepare(p->clock); p->clock_held = false;
+			ret = -ERANGE; goto out;
+		}
+		ret = mfw_mfg_power_up(&io);
+		if (!ret) p->on = true;
+	} else {
+		ret = mfw_mfg_power_down(&io);
+		if (!ret && !mfw_off(p)) ret = -EIO;
+		if (!ret) {
+			p->on = false;
+			clk_disable_unprepare(p->clock); p->clock_held = false;
+		}
+	}
+	if (ret) {
+		p->faulted = true;
+		dev_err(p->dev, "GPU power failed stage %u (%d); clock retained, reboot required\n", io.stage, ret);
+	}
+out:
+	mutex_unlock(&p->lock);
+	return ret;
+}
+struct mfw_ddk_power *mfw_ddk_power_create(struct device *dev)
+{
+	const resource_size_t bases[] = { 0x10006000, 0x10001000, 0x1020e000 };
+	struct platform_device *pdev = to_platform_device(dev);
+	struct device_node *node;
+	struct mfw_ddk_power *p;
+	unsigned int i;
+	int ret;
+	if (!of_property_present(dev->of_node, "vcore-supply")) return ERR_PTR(-EINVAL);
+	p = kzalloc(sizeof(*p), GFP_KERNEL);
+	if (!p) return ERR_PTR(-ENOMEM);
+	p->dev = dev; mutex_init(&p->lock);
+	node = of_parse_phandle(dev->of_node, "microfw,pmic-provider", 0);
+	if (!node) { ret = -EINVAL; goto fail; }
+	p->pmic = of_find_device_by_node(node); of_node_put(node);
+	if (!p->pmic) { ret = -EPROBE_DEFER; goto fail; }
+	for (i = 0; i < ARRAY_SIZE(bases); i++) {
+		struct resource *res = platform_get_resource(pdev, IORESOURCE_MEM, i + 1);
+		if (!res || res->start != bases[i] || resource_size(res) != 4096) {
+			ret = -EINVAL; goto fail;
+		}
+		p->blocks[i] = ioremap(res->start, 4096);
+		if (!p->blocks[i]) { ret = -ENOMEM; goto fail; }
+	}
+	p->clock = clk_get(dev, NULL);
+	if (IS_ERR(p->clock)) { ret = PTR_ERR(p->clock); p->clock = NULL; goto fail; }
+	if (!mfw_off(p)) { ret = -EBUSY; goto fail; }
+	return p;
+fail:
+	if (p->clock) clk_put(p->clock);
+	for (i = 0; i < ARRAY_SIZE(bases); i++) if (p->blocks[i]) iounmap(p->blocks[i]);
+	if (p->pmic) put_device(&p->pmic->dev);
+	kfree(p);
+	return ERR_PTR(ret);
+}
+void mfw_ddk_power_destroy(struct mfw_ddk_power *p)
+{
+	unsigned int i;
+	if (mfw_set_power(p, false) || p->clock_held) {
+		/* Keep the prepared clock and backing context alive until reboot. */
+		get_device(p->dev);
+		dev_err(p->dev, "GPU fault: power context pinned until reboot\n");
+		return;
+	}
+	clk_put(p->clock);
+	for (i = 0; i < ARRAY_SIZE(p->blocks); i++) iounmap(p->blocks[i]);
+	put_device(&p->pmic->dev);
+	kfree(p);
+}
+PVRSRV_ERROR mfw_ddk_pre_power(IMG_HANDLE handle, PVRSRV_DEV_POWER_STATE next,
+	PVRSRV_DEV_POWER_STATE current_state, IMG_BOOL forced)
+{
+	if (next == PVRSRV_DEV_POWER_STATE_OFF && current_state == PVRSRV_DEV_POWER_STATE_ON)
+		return mfw_set_power(handle, false) ? PVRSRV_ERROR_INIT_FAILURE : PVRSRV_OK;
+	return PVRSRV_OK;
+}
+PVRSRV_ERROR mfw_ddk_post_power(IMG_HANDLE handle, PVRSRV_DEV_POWER_STATE next,
+	PVRSRV_DEV_POWER_STATE current_state, IMG_BOOL forced)
+{
+	if (next == PVRSRV_DEV_POWER_STATE_ON && current_state == PVRSRV_DEV_POWER_STATE_OFF)
+		return mfw_set_power(handle, true) ? PVRSRV_ERROR_INIT_FAILURE : PVRSRV_OK;
+	return PVRSRV_OK;
+}
