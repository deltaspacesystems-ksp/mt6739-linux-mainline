+++ b/services/server/env/linux/mfw-dmabuf-fill.h
@@ -0,0 +1,60 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef MFW_DMABUF_FILL_H
+#define MFW_DMABUF_FILL_H
+
+#ifndef MFW_DMABUF_FILL_TEST
+#include <linux/dma-buf.h>
+#include <linux/iosys-map.h>
+#include <linux/slab.h>
+#endif
+
+/* Called without a reservation lock. CPU writes use the same DMA direction
+ * at begin/end; unlocked vmap helpers acquire the reservation lock internally.
+ * Preserve stock poison restart at every page, including a short final page.
+ */
+static int mfw_fill_dmabuf(struct dma_buf *buf, const unsigned char *pattern,
+			 size_t pattern_size)
+{
+	struct iosys_map map = { 0 };
+	unsigned char *page = NULL;
+	size_t offset, i, bytes;
+	int err, end_err;
+
+	if (pattern && !pattern_size)
+		return -EINVAL;
+	if (pattern) {
+		page = kmalloc(PAGE_SIZE, GFP_KERNEL);
+		if (!page)
+			return -ENOMEM;
+		for (i = 0; i < PAGE_SIZE; i++)
+			page[i] = pattern[i % pattern_size];
+	}
+	err = dma_buf_begin_cpu_access(buf, DMA_TO_DEVICE);
+	if (err)
+		goto out_free;
+	err = dma_buf_vmap_unlocked(buf, &map);
+	if (err)
+		goto out_access;
+	if (iosys_map_is_null(&map)) {
+		err = -ENOMEM;
+		goto out_unmap;
+	}
+	if (!pattern) {
+		iosys_map_memset(&map, 0, 0, buf->size);
+	} else {
+		for (offset = 0; offset < buf->size; offset += bytes) {
+			bytes = min_t(size_t, PAGE_SIZE, buf->size - offset);
+			iosys_map_memcpy_to(&map, offset, page, bytes);
+		}
+	}
+out_unmap:
+	dma_buf_vunmap_unlocked(buf, &map);
+out_access:
+	end_err = dma_buf_end_cpu_access(buf, DMA_TO_DEVICE);
+	if (!err)
+		err = end_err;
+out_free:
+	kfree(page);
+	return err;
+}
+#endif
