+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef MFW_LINUX_COMPAT_H
+#define MFW_LINUX_COMPAT_H
+#ifdef MFW_LINUX_COMPAT_TEST
+#include <stddef.h>
+#include <string.h>
+#else
+#include <linux/types.h>
+#include <linux/string.h>
+#endif
+
+/* Keep old DDK fixed-width fields unchanged: strncpy is not strscpy. */
+static inline char *mfw_ddk_strncpy(char *dst, const char *src, size_t size)
+{
+	size_t copied = strnlen(src, size);
+	memcpy(dst, src, copied);
+	if (copied < size)
+		memset(dst + copied, 0, size - copied);
+	return dst;
+}
+
+/* Some DDK callers require strlcpy's source-length return on truncation. */
+static inline size_t mfw_ddk_strlcpy(char *dst, const char *src, size_t size)
+{
+	size_t length = strlen(src);
+	if (size) {
+		size_t copied = length < size - 1 ? length : size - 1;
+		memcpy(dst, src, copied);
+		dst[copied] = '\0';
+	}
+	return length;
+}
+#define strncpy mfw_ddk_strncpy
+#define strlcpy mfw_ddk_strlcpy
+#endif
