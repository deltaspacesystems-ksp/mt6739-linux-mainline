+		psRGXFWInitScratch->ui64HWPerfFilter = psDevInfo->ui64HWPerfFilter;
+	}
+
+#if defined (PDUMP)
+	/* When PDUMP is enabled, ALWAYS allocate on-demand HWPerf resources
+	 * (irrespective of HWPerf enabled or not), given that HWPerf can be
