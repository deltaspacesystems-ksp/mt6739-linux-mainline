+	g_ui32HashRefCount++;
+#if !defined(PVRSRV_USE_BRIDGE_LOCK)
+	mutex_unlock(&g_HashLock);
+#endif
+#endif
+
+	*ppsPMRPtr = psPMR;
+	*puiSize = ui32NumVirtChunks * uiChunkSize;
+	*puiAlign = PAGE_SIZE;
+
+	return PVRSRV_OK;
+
+#if !defined(ANDROID)
+errUnrefPMR:
+	PMRUnrefPMR(psPMR);
+#endif
+
+errDMADetach:
+	dma_buf_detach(psDmaBuf, psAttachment);
+
+errDMAPut:
+	dma_buf_put(psDmaBuf);
+
+errReturn:
+	PVR_ASSERT(eError != PVRSRV_OK);
+	return eError;
+}
