+static struct adf_device_ops adf_sunxi_device_ops = {
+	.owner = THIS_MODULE,
+	.base = {
+		.open = adf_sunxi_open,
+		.release = adf_sunxi_release,
+		.ioctl = adf_img_ioctl,
+	},
+	.state_free = adf_sunxi_state_free,
+	.validate = adf_sunxi_validate,
+	.post = adf_sunxi_post,
+};
