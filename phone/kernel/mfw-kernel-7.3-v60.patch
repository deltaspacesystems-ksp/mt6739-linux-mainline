+	IMG_UINT32				temperature_time;
+
+#if USE_HRTIMER
+	struct hrtimer			timer;
+#endif
+	IMG_BOOL				timer_active;
+
+#if USE_KTHREAD
+	/*dvfs kthread*/
+	struct task_struct		*dvfs_task;
+	wait_queue_head_t		dvfs_wait;
+#endif
+
+	/*To calculate utilization for x sec */
