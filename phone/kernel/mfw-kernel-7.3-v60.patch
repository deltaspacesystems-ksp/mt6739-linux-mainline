+ *****************************************************************************/
+
+#define RGXFW_ALIGN_CHECKS_INIT_KM                                           \
+		sizeof(RGXFWIF_INIT),                                        \
+		offsetof(RGXFWIF_INIT, sFaultPhysAddr),                      \
+		offsetof(RGXFWIF_INIT, sPDSExecBase),                        \
+		offsetof(RGXFWIF_INIT, sUSCExecBase),                        \
