+	u8 mHSyncPolarity;
+	u16 mVActive;
+	u16 mVBlanking;
+	u16 mVBorder;
+	u16 mVImageSize;
+	u16 mVFrontPorchWidth;
+	u16 mVBackPorchWidth;
+	u16 mVSyncPulseWidth;
+	/** 0 for Active low, 1 active high */
+	u8 mVSyncPolarity;
+
+	u8 mValid;
+} DTD;
