+	PDumpInternalVarToReg64(RGX_PDUMPREG_NAME,
+	                        ui32Config1RegAddr,
+	                        ":SYSMEM:$1",
+	                        PDUMP_FLAGS_CONTINUOUS);
+
+	/* this can be written directly */
+	RGXWriteReg64(hPrivate,
+	              ui32Config2RegAddr,
+	              (ui64Config2PhyAddr & ui64Config2PhyMask) | ui64Config2Settings);
