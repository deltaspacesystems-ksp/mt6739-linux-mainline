+		g_psDmaBufHash = HASH_Create(DMA_BUF_HASH_SIZE);
+		if (!g_psDmaBufHash)
+		{
+#if !defined(PVRSRV_USE_BRIDGE_LOCK)
+			mutex_unlock(&g_HashLock);
+#endif
+			eError = PVRSRV_ERROR_OUT_OF_MEMORY;
+			goto errUnrefPMR;
+		}
+	}
