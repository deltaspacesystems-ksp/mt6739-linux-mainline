+
+			if (PVRGpuTraceEnabled())
+				trace_gpu_freq(ui32GPUFreq);
+
+
+	#endif
+			MTKWriteBackFreqToRGX(psDevNode, ui32GPUFreq);
+
+	#ifdef MTK_DEBUG
+		if (gpu_debug_enable)
+			pr_debug("PVR_K: 3DFreq=%d, Volt=%d\n", ui32GPUFreq, mt_gpufreq_get_cur_volt());
+	#endif
+
+			if (eResult == PVRSRV_OK)
