+static void MTKCommitFreqIdx(unsigned long ui32NewFreqID, GED_DVFS_COMMIT_TYPE eCommitType, int *pbCommited)
+{
+	PVRSRV_DEV_POWER_STATE ePowerState;
+	PVRSRV_DEVICE_NODE *psDevNode = MTKGetRGXDevNode();
