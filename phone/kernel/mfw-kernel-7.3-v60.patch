+static void MTKFreqInputBoostCB(unsigned int ui32BoostFreqID)
+{
+	if (g_iSkipCount > 0)
+		return;
+
+
+	if (boost_gpu_enable == 0)
+		return;
+
+	OSLockAcquire(ghDVFSLock);
