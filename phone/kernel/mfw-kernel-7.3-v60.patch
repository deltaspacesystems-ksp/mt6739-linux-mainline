+static const struct pdp_format *pdp_format(u32 drm_format)
+{
+	int i;
+
+	for (i = 0; pdp_format_table[i].drm_format != 0; i++) {
+		if (pdp_format_table[i].drm_format == drm_format)
+			return &pdp_format_table[i];
+	}
+	BUG();
+	return NULL;
+}
