+	if (psComm != NULL)
+	{
+		PVR_ASSERT((eOp == RGX_INIT_OP_DBG_READ32_HW_REG) ||
+		           (eOp == RGX_INIT_OP_DBG_READ64_HW_REG));
+
+		psComm->sDBGReadHWReg.eOp = eOp;
+		psComm->sDBGReadHWReg.ui32Offset = ui32Offset;
+
+		strcpy(&psComm->sDBGReadHWReg.aszName[0], pszName);
+
+		return IMG_TRUE;
+	}
+
+	return IMG_FALSE;
