+	if (ui32BoostFreqID < mt_gpufreq_get_cur_freq_index()) {
+		if (MTKDoGpuDVFS(ui32BoostFreqID, gpu_dvfs_cb_force_idle == 0 ? IMG_FALSE : IMG_TRUE))
+			g_sys_dvfs_time_ms = OSClockms();
+	}
+
+	OSLockRelease(ghDVFSLock);
+
+}
