+							\
+		sizeof(RGXFWIF_HWRTDATA), \
+		offsetof(RGXFWIF_HWRTDATA, psPMMListDevVAddr), \
+		offsetof(RGXFWIF_HWRTDATA, apsFreeLists),\
+		offsetof(RGXFWIF_HWRTDATA, ui64VCECatBase), \
