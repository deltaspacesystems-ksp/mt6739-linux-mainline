+			ui32CurFreqID = mt_gpufreq_get_cur_freq_index();
+			ui32GPUFreq = mt_gpufreq_get_frequency_by_level(ui32CurFreqID);
+			gpu_freq = ui32GPUFreq;
+	#if defined(CONFIG_TRACING) && defined(CONFIG_MTK_SCHED_TRACERS)
