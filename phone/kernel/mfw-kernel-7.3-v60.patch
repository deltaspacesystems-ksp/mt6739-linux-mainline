+struct adf_fbdev_dmabuf {
+	struct sg_table	sg_table;
+	size_t offset;
+	size_t length;
+	void *vaddr;
+
+	/* Used for cleanup of dmabuf private data */
+	spinlock_t *alloc_lock;
+	u8 *alloc_mask;
