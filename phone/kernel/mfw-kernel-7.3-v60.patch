+#include <linux/reservation.h>
+#include <linux/version.h>
+
+#include <drm/drmP.h>
+#if (LINUX_VERSION_CODE >= KERNEL_VERSION(3, 18, 0))
+#include <drm/drm_gem.h>
+#endif
+
+#include "tc_drv.h"
+#include "pvrversion.h"
