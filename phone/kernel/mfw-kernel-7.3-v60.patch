+#include <drm/drm_device.h>
+#include <drm/drm_drv.h>
+#include <drm/drm_print.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include "module_common.h"
+#include "pvr_drv.h"
+#include "pvr_fence.h"
+
+#ifdef MODULE
+#error "MICROFW DDK bringup currently supports built-in only"
+#endif
+
+/* Future explicit bringup only; no GPU activation on a default boot. */
+static bool enable;
+module_param(enable, bool, 0600);
+MODULE_PARM_DESC(enable, "Explicitly permit native MICROFW GPU initialization");
+
+static int pvr_probe(struct platform_device *pdev)
+{
+	struct drm_device *ddev;
+	int ret;
+	if (!enable)
+		return dev_err_probe(&pdev->dev, -ENODEV, "Native GPU binding disabled\n");
+	ddev = drm_dev_alloc(&pvr_drm_generic_driver, &pdev->dev);
+	if (IS_ERR(ddev))
+		return PTR_ERR(ddev);
+	ret = pvr_drm_device_init(ddev);
+	if (ret)
+		goto put;
+	ret = drm_dev_register(ddev, 0);
+	if (!ret)
+		return 0;
+	pvr_drm_device_fini(ddev);
+put:
+	dev_set_drvdata(&pdev->dev, NULL);
+	drm_dev_put(ddev);
+	return ret;
+}
+
+static void pvr_remove(struct platform_device *pdev)
+{
+	struct drm_device *ddev = platform_get_drvdata(pdev);
+	drm_dev_unplug(ddev);
+	pvr_drm_device_fini(ddev);
+	platform_set_drvdata(pdev, NULL);
+	drm_dev_put(ddev);
+}
+static void pvr_shutdown(struct platform_device *pdev)
+{
+	struct drm_device *ddev = platform_get_drvdata(pdev);
+	if (ddev)
+		PVRSRVCommonDeviceShutdown(ddev->dev_private);
+}
+static const struct of_device_id pvr_of_ids[] = {
+	{ .compatible = "microfw,mt6739-rogue-ddk19" }, { }
+};
+MODULE_DEVICE_TABLE(of, pvr_of_ids);
+static struct platform_driver pvr_platform_driver = {
+	.driver = {
+		.name = "microfw-pvrsrvkm",
+		.of_match_table = pvr_of_ids,
+		.pm = &pvr_pm_ops,
+		.suppress_bind_attrs = true,
+	},
+	.probe = pvr_probe, .remove = pvr_remove, .shutdown = pvr_shutdown,
+};
+static int __init pvr_init(void)
+{
+	int ret = pvr_fence_global_init();
+	if (ret)
+		return ret;
+	ret = PVRSRVCommonDriverInit();
+	if (ret) {
+		pvr_fence_global_fini();
+		return ret;
+	}
+	ret = platform_driver_register(&pvr_platform_driver);
+	if (ret) {
+		PVRSRVCommonDriverDeinit();
+		pvr_fence_global_fini();
+	}
+	return ret;
+}
+late_initcall(pvr_init);
