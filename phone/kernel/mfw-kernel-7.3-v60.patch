+			PVRSRV_DEV_POWER_STATE ePowerState;
+
+			PVRSRVGetDevicePowerState(psDevNode, &ePowerState);
+
+			if (ePowerState == PVRSRV_DEV_POWER_STATE_ON) {
+				mt_gpufreq_target(ui32NewFreqID);
+				g_bUnsync = IMG_FALSE;
+			} else {
+				g_ui32_unsync_freq_id = ui32NewFreqID;
+				g_bUnsync = IMG_TRUE;
