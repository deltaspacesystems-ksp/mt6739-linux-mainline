+enum pvr_fence_sync_val {
+	PVR_FENCE_SYNC_VAL_INIT = 0x60606060,
+	PVR_FENCE_SYNC_VAL_SIGNALED = 0x90909090,
+	PVR_FENCE_SYNC_VAL_DONE = 0xDEADDEAD,
+};
