+		y5_cp_regs(y5_wdt_base, 3);
+	{
+		void __iomem *m = ioremap(0x11200000, 0x1000);
+
+		if (m) {
+			(void)readb(m + 0x0);
+			if (y5_wdt_base)
+				y5_cp_regs(y5_wdt_base, 5);
+			writew(0x0, m + 0x82);
+			if (y5_wdt_base)
