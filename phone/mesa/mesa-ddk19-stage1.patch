diff --git a/src/imagination/vulkan/winsys/pvrsrvkm/pvr_srv_ddk19.h b/src/imagination/vulkan/winsys/pvrsrvkm/pvr_srv_ddk19.h
new file mode 100644
index 0000000..5d43b61
--- /dev/null
+++ b/src/imagination/vulkan/winsys/pvrsrvkm/pvr_srv_ddk19.h
@@ -0,0 +1,58 @@
+/* SPDX-License-Identifier: MIT
+ * Experimental fixed-platform DDK1.9 bridge translation.
+ * Wire fields checked against generated1.9 headers and native live probes.
+ * This does NOT provide a complete winsys or a complete GPU device profile.
+ */
+#ifdef PVR_MFW_DDK19
+struct mfw19_connect_in { uint32_t flags, options, version, build; } PACKED;
+struct mfw19_connect_out { uint8_t arch; uint32_t caps,pvr,rgx,error; } PACKED;
+_Static_assert(sizeof(struct mfw19_connect_in)==16,"DDK1.9 CONNECT input");
+_Static_assert(sizeof(struct mfw19_connect_out)==17,"DDK1.9 CONNECT output");
+_Static_assert(sizeof(struct drm_srvkm_cmd)==32,"DDK1.9 envelope");
+static int
+pvr_srv_ddk19_bridge_call(int fd, uint8_t bridge, uint32_t function,
+                        void *input, uint32_t insize, void *output, uint32_t outsize)
+{
+ struct drm_srvkm_cmd cmd={.bridge_id=bridge,.bridge_func_id=function};
+ if(bridge==PVR_SRV_BRIDGE_SRVCORE && function==PVR_SRV_BRIDGE_SRVCORE_CONNECT){
+  struct pvr_srv_bridge_connect_cmd *modern=input;
+  struct pvr_srv_bridge_connect_ret *converted=output;
+  struct mfw19_connect_in legacy;
+  struct mfw19_connect_out result={.error=UINT32_MAX};
+  drmVersionPtr version;
+  if(insize!=sizeof(*modern)||outsize!=sizeof(*converted)){errno=EINVAL;return -1;}
+  version=drmGetVersion(fd);
+  if(!version){errno=ENODEV;return -1;}
+  bool compatible=version->name && !strcmp(version->name,"pvr") && version->version_major==1 && version->version_minor==9 && version->version_patchlevel==4893595;
+  drmFreeVersion(version);
+  if(!compatible){errno=ENOTSUP;return -1;}
+  if(modern->flags!=32 || modern->build_options!=0x80000010 || modern->DDK_version!=0x10009 || modern->DDK_build!=4893595){errno=EINVAL;return -1;}
+  legacy=(struct mfw19_connect_in){.flags=modern->flags,.options=modern->build_options,.version=modern->DDK_version,.build=modern->DDK_build};
+  cmd.in_data_ptr=(uintptr_t)&legacy;cmd.out_data_ptr=(uintptr_t)&result;
+  cmd.in_data_size=sizeof(legacy);cmd.out_data_size=sizeof(result);
+  int rc=drmIoctl(fd,DRM_IOCTL_SRVKM_CMD,&cmd);
+  if(rc)return rc;
+  memset(converted,0,sizeof(*converted));
+  converted->error=result.error==0?PVR_SRV_OK:PVR_SRV_ERROR_BRIDGE_CALL_FAILED;
+  converted->capability_flags=result.caps;converted->kernel_arch=result.arch;
+  /* Explicit build target from measured DURA-L21; old CONNECT has no BVNC.
+   * This is target selection, never represented as a fresh hardware query.
+   * Mesa still rejects the target until a complete device profile exists. */
+  converted->bvnc=UINT64_C(0x0016003100150010);
+  return 0;
+ }
+ if(bridge==PVR_SRV_BRIDGE_SRVCORE && function==PVR_SRV_BRIDGE_SRVCORE_DISCONNECT){
+  uint32_t legacy_in=0,legacy_out=UINT32_MAX;
+  struct pvr_srv_bridge_disconnect_ret *converted=output;
+  if(insize!=0||outsize!=sizeof(*converted)){errno=EINVAL;return -1;}
+  cmd.in_data_ptr=(uintptr_t)&legacy_in;cmd.out_data_ptr=(uintptr_t)&legacy_out;
+  cmd.in_data_size=4;cmd.out_data_size=4;
+  int rc=drmIoctl(fd,DRM_IOCTL_SRVKM_CMD,&cmd);
+  if(!rc)converted->error=legacy_out==0?PVR_SRV_OK:PVR_SRV_ERROR_BRIDGE_CALL_FAILED;
+  return rc;
+ }
+ /* Never send an unchecked1.17 command/layout to a1.9 kernel. */
+ errno=ENOTSUP;
+ return -1;
+}
+#endif
